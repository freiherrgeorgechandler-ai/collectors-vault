<?xml version="1.0" encoding="utf-8"?>
<!-- Allow the APK WebView to call the HTTP vault API (AI + login). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
